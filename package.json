{
  "name": "taylordwraps-carport",
  "version": "2.0.0",
  "private": true,
  "description": "THE CARPORT — the Next.js era of the Taylor'd Wraps showcase. A wrap shop's website that transforms itself.",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-assets.mjs",
